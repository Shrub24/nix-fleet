+    /// semver requirement matching. The forge's latest release wins when
+    /// it is a candidate, since a repository may tag beside its releases
+    /// (calendar builds, other products); otherwise the highest candidate.
+    pub fn select(&self, current: &str, selection: &TagSelection) -> Option<String> {
+        let prefix = scheme_prefix(current);
+        let candidates: Vec<(Version, &String)> = self
+            .names
