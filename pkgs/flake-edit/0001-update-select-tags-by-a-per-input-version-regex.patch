+    /// The tag `selection` chooses, or `None` when no tag qualifies.
+    pub fn select(&self, selection: &TagSelection) -> Option<String> {
+        let Some(regex) = &selection.version_regex else {
+            return self.get_latest_tag();
+        };
+        self.names
+            .iter()
+            .filter_map(|name| {
+                let tag = name.strip_prefix("refs/tags/").unwrap_or(name);
+                let version = regex.captures(tag)?.get(1)?.as_str();
+                let version = Version::parse(&normalize_semver(version)).ok()?;
+                Some((version, name))
+            })
+            .max_by(|a, b| a.0.cmp_precedence(&b.0))
+            .map(|(_, name)| name.clone())
+    }
 }
 
