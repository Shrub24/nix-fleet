+/// How [`Tags::select`] chooses among a repository's tags.
+#[derive(Debug, Clone, Default)]
+pub struct TagSelection {
+    /// Only tags this matches are candidates, and capture group 1 is the
+    /// version compared. Anchored at both ends; see
+    /// [`crate::config::InputUpdateConfig::version_regex`].
+    pub version_regex: Option<regex::Regex>,
