+
+/// `[update]`: how `flake-edit update` chooses an input's new tag.
+#[derive(Debug, Clone, Serialize, Deserialize, Default)]
+#[serde(deny_unknown_fields)]
+pub struct UpdateConfig {
+    /// Per-input tag selection, keyed by input id.
+    #[serde(default)]
+    pub inputs: HashMap<String, InputUpdateConfig>,
+}
+
+/// `[update.inputs.<id>]`.
+#[derive(Debug, Clone, Serialize, Deserialize, Default)]
+#[serde(deny_unknown_fields)]
+pub struct InputUpdateConfig {
+    /// Only tags this regex matches in full are candidates, and its single
+    /// capture group is the version compared, as nix-update's
+    /// `--version-regex`: `"jq-(.*)"` selects jq's own tags, `"v(5\\..*)"`
+    /// holds the 5.x line.
+    #[serde(default)]
+    pub version_regex: Option<String>,
+}
+
+impl UpdateConfig {
+    /// Compile each input's `version_regex`, anchored at both ends.
+    ///
+    /// # Errors
+    ///
+    /// Returns the input id and reason when a regex does not compile or does
+    /// not have exactly one capture group.
+    pub fn version_regexes(&self) -> Result<HashMap<String, regex::Regex>, (String, String)> {
+        let mut compiled = HashMap::new();
+        for (id, input) in &self.inputs {
+            let Some(pattern) = &input.version_regex else {
+                continue;
+            };
+            let regex = regex::Regex::new(&format!("^(?:{pattern})$"))
+                .map_err(|e| (id.clone(), e.to_string()))?;
+            // `captures_len` counts the implicit whole-match group.
+            if regex.captures_len() != 2 {
+                return Err((id.clone(), "needs exactly one capture group".to_string()));
+            }
+            compiled.insert(id.clone(), regex);
+        }
+        Ok(compiled)
+    }
 }
 
