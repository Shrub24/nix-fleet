{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "labels": ["dependencies"],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "automerge": false,
  "schedule": ["before 6am on monday"],
  "enabledManagers": ["github-actions"],
  "packageRules": [
    {
      "matchDepTypes": ["action", "workflow"],
      "pinDigests": true
    }
  ]
}
